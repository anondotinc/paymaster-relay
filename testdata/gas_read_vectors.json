{
  "comment": "Public gas-read rules shared by gas_reads_test.go and worker/test/gas-reads.test.mjs. Each vector sends the request twice (a fresh handler and cache per vector) with the upstream answering as given. Every answer must carry X-Content-Type-Options: nosniff and CORS, and never Location, Set-Cookie, Vary or Age. cached: the second request is served without a second upstream call. upstream.bodyBytes: a body of that many 'x' bytes; upstream.contentLength: the declared Content-Length when it differs from the body; upstream.bodyError: the body stream fails after its bytes. Ambiguous answers fail closed: 502 or no-store.",
  "path": "/api/v1/tx/gas-fee/42161",
  "target": "/api/v1/tx/gas-fee/42161",
  "maxBody": 1048576,
  "vectors": [
    { "name": "fresh 200 is cached for its s-maxage",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "body": "{\"chainId\":\"42161\"}" },
      "expect": { "status": 200, "cacheControl": "public, max-age=5", "body": "{\"chainId\":\"42161\"}", "cached": true } },
    { "name": "s-maxage wins over a longer max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, max-age=600, s-maxage=5" } },
      "expect": { "status": 200, "cacheControl": "public, max-age=5", "cached": true } },
    { "name": "max-age alone",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=5" } },
      "expect": { "status": 200, "cacheControl": "public, max-age=5", "cached": true } },
    { "name": "upstream Age counts against the lifetime",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "3" } },
      "expect": { "status": 200, "cacheControl": "public, max-age=2", "cached": true } },
    { "name": "Vary on request headers the relay never forwards is dropped",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Vary": "Origin, accept-encoding" } },
      "expect": { "status": 200, "cacheControl": "public, max-age=5", "cached": true } },
    { "name": "Vary: * is uncacheable",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Vary": "*" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "Vary listing * is uncacheable",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Vary": "Origin, *" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "exhausted Age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "Age beyond the lifetime",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "60" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "non-numeric Age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "x" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "negative Age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "-1" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "signed Age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "+1" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "list-valued Age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5", "Age": "1, 2" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "no-store",
      "upstream": { "status": 200, "headers": { "Cache-Control": "no-store" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "no-cache with a lifetime",
      "upstream": { "status": 200, "headers": { "Cache-Control": "no-cache, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "no-cache with a field name",
      "upstream": { "status": 200, "headers": { "Cache-Control": "no-cache=x, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "no-cache with a quoted field list",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, no-cache=\"set-cookie\", max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "private with a lifetime",
      "upstream": { "status": 200, "headers": { "Cache-Control": "private, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "private with a quoted field list",
      "upstream": { "status": 200, "headers": { "Cache-Control": "private=\"x\", max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "zero max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=0" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "zero s-maxage overrides max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "s-maxage=0, max-age=60" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "no Cache-Control",
      "upstream": { "status": 200, "headers": {} },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "malformed s-maxage does not fall back to max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=abc, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "negative s-maxage does not fall back to max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "s-maxage=-1, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "empty s-maxage does not fall back to max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "s-maxage, max-age=5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "signed max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=+5" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "quoted max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=\"5\"" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "repeated max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=5, max-age=10" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "out-of-range max-age",
      "upstream": { "status": 200, "headers": { "Cache-Control": "max-age=99999999999999999999" } },
      "expect": { "status": 200, "cacheControl": "no-store", "cached": false } },
    { "name": "API 400 passes through uncached",
      "upstream": { "status": 400, "headers": { "Cache-Control": "public, s-maxage=60, max-age=60" }, "body": "{\"code\":\"error\"}" },
      "expect": { "status": 400, "cacheControl": "no-store", "body": "{\"code\":\"error\"}", "cached": false } },
    { "name": "API 404 passes through uncached",
      "upstream": { "status": 404, "headers": { "Cache-Control": "public, s-maxage=60, max-age=60" }, "body": "{\"code\":\"error\"}" },
      "expect": { "status": 404, "cacheControl": "no-store", "body": "{\"code\":\"error\"}", "cached": false } },
    { "name": "API 500 passes through uncached",
      "upstream": { "status": 500, "headers": { "Cache-Control": "public, s-maxage=60, max-age=60" }, "body": "{\"code\":\"error\"}" },
      "expect": { "status": 500, "cacheControl": "no-store", "body": "{\"code\":\"error\"}", "cached": false } },
    { "name": "API 503 passes through uncached",
      "upstream": { "status": 503, "headers": { "Cache-Control": "public, s-maxage=60, max-age=60" }, "body": "{\"code\":\"error\"}" },
      "expect": { "status": 503, "cacheControl": "no-store", "body": "{\"code\":\"error\"}", "cached": false } },
    { "name": "301 is a 502 without its Location",
      "upstream": { "status": 301, "headers": { "Location": "https://attacker.invalid", "Cache-Control": "max-age=60" }, "body": "" },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "302 is a 502 without its Location",
      "upstream": { "status": 302, "headers": { "Location": "https://attacker.invalid", "Cache-Control": "max-age=60" }, "body": "" },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "304 is a 502",
      "upstream": { "status": 304, "headers": { "Cache-Control": "max-age=60" }, "body": "" },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "307 is a 502 without its Location",
      "upstream": { "status": 307, "headers": { "Location": "https://attacker.invalid", "Cache-Control": "max-age=60" }, "body": "" },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "308 is a 502 without its Location",
      "upstream": { "status": 308, "headers": { "Location": "https://attacker.invalid", "Cache-Control": "max-age=60" }, "body": "" },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "a body at the 1 MiB cap is relayed",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "bodyBytes": 1048576 },
      "expect": { "status": 200, "cacheControl": "public, max-age=5", "bodyBytes": 1048576, "cached": true } },
    { "name": "a body over the 1 MiB cap is a 502",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "bodyBytes": 1048577 },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "an error body over the cap is a 502",
      "upstream": { "status": 503, "headers": {}, "bodyBytes": 1048577 },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "a declared length over the cap is a 502",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "body": "{}", "contentLength": 1048577 },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "a truncated body is a 502, never a cached 200",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "body": "{\"chainId\":", "contentLength": 64 },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "a body read error is a 502, never a cached 200",
      "upstream": { "status": 200, "headers": { "Cache-Control": "public, s-maxage=5, max-age=5" }, "body": "{\"chainId\":", "bodyError": true },
      "expect": { "status": 502, "cacheControl": "no-store", "cached": false } },
    { "name": "HEAD is refused without an upstream call",
      "method": "HEAD",
      "expect": { "status": 405, "cacheControl": "no-store", "allow": "GET, OPTIONS", "upstreamCalls": 0 } },
    { "name": "POST is refused without an upstream call",
      "method": "POST",
      "expect": { "status": 405, "cacheControl": "no-store", "allow": "GET, OPTIONS", "upstreamCalls": 0 } },
    { "name": "PUT is refused without an upstream call",
      "method": "PUT",
      "expect": { "status": 405, "cacheControl": "no-store", "allow": "GET, OPTIONS", "upstreamCalls": 0 } }
  ]
}
